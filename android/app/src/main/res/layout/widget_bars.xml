    <TextView android:id="@+id/bars_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#FF8E8D96" android:includeFontPadding="false" android:layout_marginTop="8dp" android:visibility="gone" />
