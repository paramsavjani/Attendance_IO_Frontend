        <ProgressBar android:id="@+id/bar_5" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="5dp" android:indeterminate="false" android:max="100" android:progressDrawable="@drawable/widget_bar" />
